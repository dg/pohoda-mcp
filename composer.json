{
	"name": "dg/pohoda-mcp",
	"description": "📒 Pohoda MCP: an MCP server for the Pohoda accounting software by Stormware. AI assistants can read and create invoices, orders, stock, contacts and more through the mServer XML API.",
	"keywords": ["pohoda", "stormware", "mserver", "accounting", "invoices", "mcp", "ai", "xml api"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"type": "project",
	"license": "MIT",
	"require": {
		"php": ">=8.4",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-simplexml": "*",
		"ext-xmlwriter": "*",
		"mcp/sdk": "^0.7.0",
		"symfony/finder": "^8.0"
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan": "^2.2",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"DG\\Pohoda\\": "src/"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"config": {
		"allow-plugins": {
			"php-http/discovery": true,
			"phpstan/extension-installer": true
		}
	}
}
