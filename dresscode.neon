use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

excludePaths:
	- tests/**/output

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # a tool takes its arguments by the names of the parameters
		paths: [src/McpTools.php]
		naming: {variable: keep}
